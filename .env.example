# Supabase → Project Settings → API Keys (the hamlaty project, never Qotoo's)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Secret key: server only. Put it in Vercel → Settings → Environment Variables, never in the code.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# SMS notifications to campaigns and hotels (Twilio). Without them nothing is texted.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a Messaging Service (MG…) or a sender (a name such as "Hamlaty", or a Twilio number)
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
